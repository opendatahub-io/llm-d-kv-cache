# Go build stage
FROM registry.access.redhat.com/ubi9/go-toolset:1.26.7@sha256:0a4666f7a4eb0644c97a73cba198eb268691b270d97831822689e7a2088f87be AS go-builder

ARG TARGETOS
ARG TARGETARCH

ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime

WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY internal/ internal/

USER root
RUN mkdir -p bin && chown 1001:0 bin
USER 1001

RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w" \
    -o bin/pvc-evictor \
    ./cmd/pvc-evictor

# Runtime stage
FROM registry.redhat.io/ubi9/ubi-minimal-pqc:9.8-1788217333@sha256:3e009398a8aa8eec621393fbf308c5e622f174900e44e8d5fe224c637920924a

WORKDIR /

COPY --from=go-builder --chown=65532:65532 /workspace/bin/pvc-evictor /app/pvc-evictor

USER 65532:65532

ENTRYPOINT ["/app/pvc-evictor"]

LABEL com.redhat.component="odh-llm-d-kv-pvc-evictor-rhel9" \
      name="odh-llm-d-kv-pvc-evictor-rhel9" \
      description="odh-llm-d-kv-pvc-evictor" \
      summary="odh-llm-d-kv-pvc-evictor" \
      io.k8s.display-name="odh-llm-d-kv-pvc-evictor" \
      io.k8s.description="odh-llm-d-kv-pvc-evictor"
