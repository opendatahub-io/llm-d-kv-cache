# Go build stage
FROM registry.access.redhat.com/ubi9/go-toolset:1.27.3@sha256:4053e919374d739ee6b0007e412d89256b0bd065e0bc690c2b3905bbaab6500e AS go-builder

ARG TARGETOS
ARG TARGETARCH

ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime

WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY internal/ internal/

USER root
RUN mkdir -p bin && chown 1001:0 bin
USER 1001

RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w" \
    -o bin/pvc-evictor \
    ./cmd/pvc-evictor

# Runtime stage
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2@sha256:ab67cd02caf8706e34a695a1432ebe965934f6128ec352a6c3f4048b43a4fb5e

WORKDIR /

COPY --from=go-builder --chown=65532:65532 /workspace/bin/pvc-evictor /app/pvc-evictor

USER 65532:65532

ENTRYPOINT ["/app/pvc-evictor"]

LABEL com.redhat.component="odh-llm-d-kv-pvc-evictor-rhel9" \
      name="odh-llm-d-kv-pvc-evictor-rhel9" \
      description="odh-llm-d-kv-pvc-evictor" \
      summary="odh-llm-d-kv-pvc-evictor" \
      io.k8s.display-name="odh-llm-d-kv-pvc-evictor" \
      io.k8s.description="odh-llm-d-kv-pvc-evictor"
