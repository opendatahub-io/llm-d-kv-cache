# Filesystem mount and cache location.
# CACHE_DIRECTORY must be a relative directory below PVC_MOUNT_PATH.
PVC_MOUNT_PATH=/kv-cache
CACHE_DIRECTORY=kv/model-cache/models

# Start deletion at CLEANUP_THRESHOLD and stop at TARGET_THRESHOLD.
# TARGET_THRESHOLD must be lower than CLEANUP_THRESHOLD.
CLEANUP_THRESHOLD=85.0
TARGET_THRESHOLD=70.0

# Set DRY_RUN to true to log deletion decisions without deleting files.
# LOG_LEVEL accepts DEBUG, INFO, WARNING, or ERROR.
DRY_RUN=false
LOG_LEVEL=INFO

# Number of crawler workers. Valid values are 1, 2, 4, 8, or 16.
# LOGGER_INTERVAL_SECONDS controls how often disk usage is checked.
NUM_CRAWLER_PROCESSES=8
LOGGER_INTERVAL_SECONDS=0.5

# File queue sizes and deletion batch/rate limits.
# DELETION_MAX_FILES_PER_SECOND=0 means unlimited deletion rate.
FILE_QUEUE_MAXSIZE=10000
FILE_QUEUE_MIN_SIZE=1000
DELETION_BATCH_SIZE=100
DELETION_MAX_FILES_PER_SECOND=0

# Protect files accessed within this many minutes from deletion.
# HEX_BUCKET_LEN controls cache bucket parsing and accepts 2 through 4.
FILE_ACCESS_TIME_THRESHOLD_MINUTES=60
HEX_BUCKET_LEN=3

# Remove empty cache directories when enabled. The TTL avoids racing writers.
ENABLE_DIR_CLEANUP=true
DIR_CLEANUP_TTL_SECONDS=120

# Empty LOG_FILE_PATH writes only to standard output.
# Empty STORAGE_EVENTS_ENDPOINT disables BlockRemoved event publishing.
LOG_FILE_PATH=
STORAGE_EVENTS_ENDPOINT=
